<%
  var siteName = theme.author.name || config.title;
  var since = theme.footer.since || new Date().getFullYear();
  var now = new Date().getFullYear();
  var years = since && since < now ? since + '–' + now : now;
%>
<footer class="site-footer">
  <div class="wrap">
    <span class="copyright">
      © <%= years %> <%= siteName %>
      <% if (theme.footer.powered) { %>
        · 由 <a href="https://hexo.io" target="_blank" rel="noopener">Hexo</a> 驱动，主题 Historical
      <% } %>
    </span>
    <span class="footer-extra">
      <%
        // 页脚小链接支持两种写法：
        //   新：footer.links 是数组，每项 { name, url }
        //   旧：footer.extra + footer.extra_url（一个链接，文案当标题用）
        // 两者都填时以 links 为准。
        var fLinks = [].concat((theme.footer && theme.footer.links) || []).filter(function (l) {
          return l && l.name && l.url;
        });
        if (!fLinks.length && theme.footer && theme.footer.extra) {
          fLinks = [{ name: theme.footer.extra, url: theme.footer.extra_url || '/' }];
        }
      %>
      <% fLinks.forEach(function (l) { %>
        <a href="<%- url_for(l.url) %>"><%= l.name %></a>
      <% }); %>
      <a href="<%- url_for('/') %>">回到首页</a>
    </span>
  </div>
</footer>

<button class="to-top" id="to-top" type="button" aria-label="回到顶部" hidden>↑</button>
